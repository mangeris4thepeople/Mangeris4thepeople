{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{"type": "host", "value": "mangeris4thepeople2028.vercel.app"}],
      "destination": "https://mangeris4thepeople.com/:path*",
      "permanent": true
    }
  ],
  "headers": [{"source": "/img/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]}]
}
